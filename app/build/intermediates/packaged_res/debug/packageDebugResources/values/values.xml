<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="ic_launcher_background">#557271</color>
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="splash_background">#435D56</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="verde_ibk">#435D56</color>
    <color name="white">#FFFFFFFF</color>
    <string name="app_name">IBKCheck</string>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">

        <item name="android:statusBarColor">@color/verde_ibk</item>
        <item name="android:textColorPrimary">@android:color/black</item>

        <item name="windowSplashScreenBackground">@color/verde_ibk</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.IBKCheck</item>
    </style>
    <style name="Theme.IBKCheck" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/verde_ibk</item>
    </style>
</resources>